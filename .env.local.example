# Copy this file to .env.local and fill in real values.
# .env.local is gitignored.

# Supabase — supabase.com/dashboard → Project → Settings → API
# Recommended region: Sydney (ap-southeast-2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=

# Stripe — dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
# From `stripe listen` (local) or the webhook endpoint's signing secret (prod)
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Recurring Price IDs from Stripe → Product catalog → JobUFO Pro (price_...)
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=

# Public site URL — used to build Stripe redirect URLs.
# Local: http://localhost:3000   Prod: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (waitlist emails) — resend.com → API Keys
RESEND_API_KEY=
